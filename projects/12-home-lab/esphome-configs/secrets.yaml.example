# ESPHome secrets template
# Copy this to secrets.yaml (git-ignored) and fill in real values.
# Generate new API keys and OTA passwords in the ESPHome dashboard or with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

wifi_ssid: "Your WiFi SSID"
wifi_password: "your-wifi-password"

# LD2450 (device name: erm)
api_key_ld2450: "generate-a-new-32-byte-base64-key"
ota_password_ld2450: "generate-a-random-hex-string"
fallback_password_ld2450: "generate-a-random-password"

# LD2451
api_key_ld2451: "generate-a-new-32-byte-base64-key"
ota_password_ld2451: "generate-a-random-hex-string"
fallback_password_ld2451: "generate-a-random-password"

# C4001 / SEN0609 (device name: beam)
api_key_c4001: "generate-a-new-32-byte-base64-key"
ota_password_c4001: "generate-a-random-hex-string"
fallback_password_c4001: "generate-a-random-password"
